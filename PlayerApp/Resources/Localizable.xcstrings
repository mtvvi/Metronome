    "Removed indexed tracks for %@. Folder access is retained." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Индексированные треки для %@ удалены. Доступ к папке сохранён." } } } },
    "Removed the index and forgot access to %@. Files were not deleted." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Индекс удалён, доступ к %@ забыт. Файлы не удалялись." } } } },
