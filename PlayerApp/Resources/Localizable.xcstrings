    "Imported %lld audio files from %@." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Из %2$@ импортировано аудиофайлов: %1$lld." } } } },
    "Imported %lld bands with %lld warnings." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Импортировано полос: %lld; предупреждений: %lld." } } } },
