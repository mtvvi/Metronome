    "Imported %lld of %lld audio files from %@. Failed metadata for %lld." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Из %3$@ импортировано %1$lld из %2$lld аудиофайлов. Не удалось прочитать метаданные для %4$lld." } } } },
    "Imported %lld playable Music Library tracks. Kept %lld protected and %lld unavailable items with playback disabled." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Из медиатеки импортировано воспроизводимых треков: %lld. Сохранено защищённых объектов: %lld и недоступных объектов: %lld; их воспроизведение отключено." } } } },
    "Invalid equalizer data on line %lld." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Некорректные данные эквалайзера в строке %lld." } } } },
