    "Automatic attenuation: %@ dB" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Автоматическое ослабление: %@ дБ" } } } },
    "Band %lld, %@, %lld hertz, %@ decibels, %@" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Полоса %lld, %@, %lld герц, %@ децибел, %@" } } } },
    "Choose whether Metronome should retain permission to %@. Audio files are never deleted." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выберите, должно ли приложение сохранить доступ к %@. Аудиофайлы никогда не удаляются." } } } },
    "Enter exact value for %@" : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "Введите точное значение для параметра «%@»" } } } },
    "Equalizer response graph. Selected band at %lld hertz, %@ decibels. Swipe up or down to adjust gain." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "График АЧХ эквалайзера. Выбрана полоса %lld герц, %@ децибел. Смахните вверх или вниз, чтобы изменить усиление." } } } },
    "Found %lld audio files in %@." : { "localizations" : { "ru" : { "stringUnit" : { "state" : "translated", "value" : "В %2$@ найдено аудиофайлов: %1$lld." } } } },
